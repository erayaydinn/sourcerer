# Copy to .env (never committed). Shell variables win over .env.

# Repo paths (required), e.g. SOURCERER_FRONTEND=/Users/you/code/web-app
SOURCERER_FRONTEND=
SOURCERER_BACKEND=

# Per role, overriding sourcerer.yaml for every agent of that role (good for one-off runs).
# To choose per agent and keep it, use `sourcerer use <agent|role> <profile> [--model m]` instead.
# The model must exist in that profile's CLI (claude: opus/sonnet; cursor: docs/cli-help/cursor-agent-models.txt).
SOURCERER_PLANNER_LLM=
SOURCERER_PLANNER_MODEL=
SOURCERER_CODER_LLM=
SOURCERER_CODER_MODEL=
SOURCERER_REVIEWER_LLM=
SOURCERER_REVIEWER_MODEL=

# Limits (defaults: 5, 2, 3). maxRounds = coder passes per task, 1 means no fix rounds.
SOURCERER_MAX_COST_PER_RUN=
SOURCERER_MAX_COST_PER_AGENT=
SOURCERER_MAX_ROUNDS=
# Token limits: input + output tokens (cache reads not counted). Empty = no token limit.
SOURCERER_MAX_TOKENS_PER_RUN=
SOURCERER_MAX_TOKENS_PER_AGENT=

# Only needed for profiles that set keyEnv.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
