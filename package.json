{
  "name": "@erayaydinn/sourcerer",
  "version": "0.1.0",
  "description": "Orchestrator + subagent factory: planner, parallel frontend/backend coders and a reviewer, each on its own LLM",
  "type": "module",
  "bin": {
    "sourcerer": "src/cli/index.js"
  },
  "files": [
    "src",
    "config",
    "agents",
    ".env.example",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.9",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/erayaydinn/sourcerer.git"
  },
  "license": "UNLICENSED",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "eslint .",
    "test": "node --test \"test/**/*.test.js\"",
    "validate": "node src/cli/index.js validate",
    "smoke": "node src/cli/index.js smoke"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "commander": "14.0.3",
    "execa": "9.6.1",
    "ink": "8.0.0",
    "openai": "6.49.0",
    "react": "19.3.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "ink-testing-library": "4.0.0"
  }
}
